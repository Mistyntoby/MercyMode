Keybinds: {
	JoinBattle.DisplayName: Join Battle
	BattleConfirm.DisplayName: Battle: Confirm / Shoot
	BattleBack.DisplayName: Battle: Back / Move Slower
	BattleUp.DisplayName: Battle: Up
	BattleDown.DisplayName: Battle: Down
	BattleLeft.DisplayName: Battle: Left
	BattleRight.DisplayName: Battle: Right
}

Configs: {
	MercyConfig: {
		DisplayName: Mercy Mode

		TurnBasedBattles: {
			Label: Deltarune-style turn-based boss battles
			Tooltip: Touching or hitting a boss opens a battle screen with FIGHT, ACT, ITEM, SPARE and DEFEND.
		}

		BattlesWithEnemies: {
			Label: Battles with regular enemies too
			Tooltip: Slimes, zombies, Demon Eyes and other regular enemies also start battles when you touch or hit them. Turn off to keep battles for bosses only.
		}

		FightDamageMultiplier: {
			Label: FIGHT damage multiplier
			Tooltip: FIGHT deals weapon damage x (timing points / 20), like Deltarune's AT x points / 20. Raise this for shorter fights.
		}

		UseDeltaruneAssets: {
			Label: Use assets from your Deltarune install
			Tooltip: Loads the real SOUL sprite and sounds from your own copy of Deltarune. Nothing from Deltarune ships with this mod.
		}

		DeltaruneFolder: {
			Label: Deltarune folder (leave empty to auto-detect)
			Tooltip: Only needed if Deltarune isn't in a normal Steam library.
		}

		Chapter: {
			Label: Chapter to load from (0 = newest)
			Tooltip: Which chapter's data.win to read assets from.
		}

		BattleSoundVolume: {
			Label: Battle sound volume
			Tooltip: Scales Mercy Mode sound effects relative to Terraria's sound volume. The default is intentionally quieter than full volume.
		}

		BattleMusicVolume: {
			Label: Battle music volume
			Tooltip: Scales battle music relative to Terraria's music volume.
		}

		MenuSoundRedirect: {
			Label: Menu sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for battle menu navigation and selection sounds.
		}

		BattleSoundRedirect: {
			Label: Combat sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for hit, slash, and critical-hit sounds.
		}

		ActionSoundRedirect: {
			Label: Action sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for healing, item, spare, and weapon sounds.
		}

		MercyGainSoundRedirect: {
			Label: MERCY gain sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for the sound played when an ACT raises MERCY.
		}

		GrazeSoundRedirect: {
			Label: Graze sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for graze sounds.
		}

		BattleStartSoundRedirect: {
			Label: Battle start sound redirect
			Tooltip: Choose Deltarune sounds, a Terraria sound, or Silent for the battle-entry sound.
		}

		PartyColor: {
			Label: Party Color
			Tooltip: Your colour in multiplayer battles: your battle UI, and your box and SOUL on the others' screens. Automatic picks by the order players joined the server.
		}

		EventBattles: {
			Label: Event Battles
			Tooltip: ""
		}

		BossBattleMusic: {
			Label: Boss Battle Music
			Tooltip: ""
		}

		BossMusicBoost: {
			Label: Boss Music Boost
			Tooltip: ""
		}
	}

	PartyColorChoice: {
		Tooltip: ""

